{
  "name": "simple-workers",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "check": "biome check .",
    "check:ci": "biome ci .",
    "test": "pnpm -r test",
    "cf-typegen": "pnpm -r cf-typegen",
    "deploy:redirector": "pnpm --filter redirector cf-deploy",
    "deploy:assets": "pnpm --filter assets cf-deploy",
    "install-hooks": "prek install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "~5.0.0",
    "wrangler": "^4.151.0"
  }
}
