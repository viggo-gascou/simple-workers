  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vitest-plugin": "^1.1.7",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.131.0"
  }
}
